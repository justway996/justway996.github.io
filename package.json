{
  "name": "codex-skill-toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 file:dist/main/main.js && electron .\"",
    "test": "vitest run",
    "build": "tsc -p tsconfig.main.json && tsc --noEmit && vite build",
    "dist": "pnpm build && node scripts/ensure-packaging-config.mjs && electron-builder",
    "tsc": "tsc",
    "vitest": "vitest"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.4"
  }
}
